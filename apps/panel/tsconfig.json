{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@operator/ae-types": ["../../packages/ae-types/src/index.ts"],
      "@operator/ae-mock": ["../../packages/ae-mock/src/index.ts"],
      "@operator/protocol": ["../../packages/protocol/src/index.ts"],
      "@operator/command-core": ["../../packages/command-core/src/index.ts"],
      "@operator/host-adapter": ["../../packages/host-adapter/src/index.ts"],
      "@operator/pathkit": ["../../packages/pathkit/src/index.ts"],
      "@operator/parsers": ["../../packages/parsers/src/index.ts"],
      "@operator/i18n": ["../../packages/i18n/src/index.ts"],
      "@operator/jsx": ["../jsx/src/index.ts"],
      "@operator/jsx/inproc": ["../jsx/src/inproc.ts"],
      "@operator/ui-kit": ["../../packages/ui-kit/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "../jsx/src/globals.d.ts"]
}
